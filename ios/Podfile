# Resolve react_native_pods.rb with node to allow for hoisting
require Pod::Executable.execute_command('node', ['-p',
  'require.resolve(
    "react-native/scripts/react_native_pods.rb",
    {paths: [process.argv[1]]},
  )', __dir__]).strip

platform :ios, '15.5'
prepare_react_native_project!

linkage = ENV['USE_FRAMEWORKS']
if linkage != nil
  Pod::UI.puts "Configuring Pod with #{linkage}ally linked Frameworks".green
  use_frameworks! :linkage => linkage.to_sym
end

target 'FrontendBlogMobile' do
  config = use_native_modules!

  use_react_native!(
    :path => config[:reactNativePath],
    # An absolute path to your application root.
    :app_path => "#{Pod::Config.instance.installation_root}/.."
  )

  post_install do |installer|
    react_native_post_install(
      installer,
      config[:reactNativePath],
      :mac_catalyst_enabled => false,
      # :ccache_enabled => true
    )

    # Fix: Inject Hermes V1 defines into xcconfig files for React-hermes and React-RuntimeHermes.
    # These targets are PBXAggregateTargets (no compilation phases) in React-Core-prebuilt setup,
    # so target-level build settings (even when set in project.pbxproj) don't propagate to
    # compilation units that include Registration.h transitively.
    # Without HERMES_V1_ENABLED=1, Registration.h's guard fails and it tries to include
    # hermes/inspector/RuntimeAdapter.h which doesn't exist in Hermes V1 prebuilt.
    # We patch the xcconfig files directly since aggregate targets ignore pbxproj-level settings.
    hermes_targets = ['React-hermes', 'React-RuntimeHermes']
    hermes_targets.each do |target_name|
      ['Debug', 'Release'].each do |config_name|
        xcconfig_path = File.join(installer.sandbox.root, 'Target Support Files', target_name, "#{target_name}.#{config_name.downcase}.xcconfig")
        if File.exist?(xcconfig_path)
          xcconfig_content = File.read(xcconfig_path)
          unless xcconfig_content.include?('HERMES_V1_ENABLED')
            # Append both HERMES_ENABLE_DEBUGGER=1 and HERMES_V1_ENABLED=1 to the first line
            xcconfig_content.gsub!(
              /(GCC_PREPROCESSOR_DEFINITIONS = .*)$/,
              "\\1 HERMES_ENABLE_DEBUGGER=1 HERMES_V1_ENABLED=1"
            )
            File.write(xcconfig_path, xcconfig_content)
            Pod::UI.puts "  [Hermes V1 Fix] Patched #{target_name} (#{config_name}) xcconfig".green
          else
            Pod::UI.puts "  [Hermes V1 Fix] Already patched #{target_name} (#{config_name}) xcconfig".yellow
          end
        end
      end
    end

    # Fix: Ensure all pod targets generate dSYM files for proper symbolication.
    # Without this, React.framework and other pods may be missing dSYM files,
    # causing App Store Connect validation warnings (missing dSYM for UUID).
    Pod::UI.puts "  [dSYM Fix] Enabling dwarf-with-dsym for all pod targets".green

    # Set DEBUG_INFORMATION_FORMAT at the Pods PROJECT level (inherited by all native targets)
    installer.pods_project.build_configurations.each do |config|
      config.build_settings['DEBUG_INFORMATION_FORMAT'] = 'dwarf-with-dsym'
    end

    # Also set at the TARGET level for any targets that override project defaults.
    # For hermes-related targets, also disable stripping so the embedded binary
    # keeps the same UUID as the source — otherwise Xcode's STRIP_INSTALLED_PRODUCT
    # changes the UUID during archive and the dSYM no longer matches.
    installer.pods_project.targets.each do |target|
      target.build_configurations.each do |config|
        config.build_settings['DEBUG_INFORMATION_FORMAT'] = 'dwarf-with-dsym'
        if target.name.downcase.include?('hermes')
          config.build_settings['COPY_PHASE_STRIP'] = 'NO'
          config.build_settings['STRIP_INSTALLED_PRODUCT'] = 'NO'
        end
      end
    end

    # Generate dSYM files for pre-built XCFrameworks that ship without dSYM bundles.
    # These are binary-distributed frameworks (React.xcframework, ReactNativeDependencies.xcframework,
    # hermesvm.xcframework) where DEBUG_INFORMATION_FORMAT has no effect because
    # there's no source compilation step. We use dsymutil to extract debug info.
    #
    # IMPORTANT: We run dsymutil against the *embedded* binary in $BUILT_PRODUCTS_DIR
    # (the copy Xcode has already processed), NOT the source binary in $PODS_ROOT.
    # This guarantees the dSYM UUID matches the binary that lands in the archive,
    # because any stripping/re-signing Xcode performs changes the UUID of the copy.
    # We also never skip based on "dSYM already exists" — a stale dSYM from a
    # previous build with an old UUID would silently shadow the correct one.
    Pod::UI.puts "  [dSYM Fix] Adding/updating build phase to generate dSYMs for prebuilt XCFrameworks".green
    main_target = installer.aggregate_targets.first.user_targets.first
    phase_name = 'Generate dSYMs for prebuilt XCFrameworks'
    # Find existing phase or create a new one — always overwrite the script so
    # changes to the Podfile are reflected without manually editing the pbxproj.
    phase = main_target.build_phases.find { |p| p.respond_to?(:name) && p.name == phase_name }
    phase ||= main_target.new_shell_script_build_phase(phase_name)
    phase.shell_script = <<-'SCRIPT'
set -e
# Only run for Release builds (including Release-Prod, Release-Test)
if [ "$CONFIGURATION" != "Release" ] && [[ "$CONFIGURATION" != Release-* ]]; then
  echo "[dSYM] Skipping: non-Release build ($CONFIGURATION)"
  exit 0
fi

echo "[dSYM] Generating dSYM files for pre-built XCFrameworks..."

DSYM_OUTPUT_DIR="${DWARF_DSYM_FOLDER_PATH}"

# Use the already-embedded copies in BUILT_PRODUCTS_DIR so the dSYM UUID
# matches the binary that is actually placed into the archive.
# (Running dsymutil on the Pods source binary would give the pre-strip UUID,
# which mismatches the stripped/processed binary App Store Connect validates.)
FRAMEWORKS_DIR="${BUILT_PRODUCTS_DIR}/${FRAMEWORKS_FOLDER_PATH}"

FRAMEWORK_NAMES=("hermesvm" "React" "ReactNativeDependencies")

for NAME in "${FRAMEWORK_NAMES[@]}"; do
  BINARY_PATH="${FRAMEWORKS_DIR}/${NAME}.framework/${NAME}"

  if [ ! -f "$BINARY_PATH" ]; then
    echo "[dSYM] Info: embedded binary not found at $BINARY_PATH — skipping $NAME (may be statically linked)"
    continue
  fi

  DSYM_DEST="${DSYM_OUTPUT_DIR}/${NAME}.framework.dSYM"

  # Always regenerate — never skip based on existence.
  # A stale dSYM from a previous build would have a wrong UUID and shadow the correct one.
  echo "[dSYM] Generating dSYM for $NAME from embedded binary..."
  if xcrun dsymutil "$BINARY_PATH" -o "$DSYM_DEST" 2>/dev/null; then
    echo "[dSYM] ✓ Generated dSYM for $NAME"
  else
    echo "[dSYM] Note: dsymutil produced no output for $NAME (statically merged into app binary — OK)"
  fi
done

echo "[dSYM] Done generating dSYM files"
    SCRIPT
    Pod::UI.puts "  [dSYM Fix] Updated build phase '#{phase_name}' on main target".green
  end
end
